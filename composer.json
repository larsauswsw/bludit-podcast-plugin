{
    "name": "larsauswsw/bludit-podcast-plugin-dev",
    "description": "Entwicklungswerkzeuge für das Podcast-Plugin (Tests, statische Analyse) – nicht Teil des Plugin-Pakets",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "phpstan/phpstan": "2.1.*",
        "phpunit/phpunit": "9.6.*"
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    }
}
